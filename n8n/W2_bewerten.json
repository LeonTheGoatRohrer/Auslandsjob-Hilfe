    {
      "parameters": {
        "jsCode": "// Claude-Antworten prüfen, Zitate gegen die Anzeige verifizieren, Cache je Quelle zusammenbauen.\nconst cfg = $('Konfiguration').first().json;\nconst auftraege = $('Aufträge bauen').all();\nconst antworten = $input.all();\nconst jetzt = new Date().toISOString();\nconst ENUMS = { bezahlung: ['lohn','taschengeld','unterkunft_gegen_arbeit','unbezahlt','kostet_geld','unklar'],\n  unterkunft: ['beim_betrieb','crew_haus','schiff','selbst_organisieren','unklar'],\n  verpflegung: ['ja','nein','nicht_angegeben'], englisch: ['ja','teilweise','nein','nicht_angegeben'] };\nconst norm = s => (s || '').toLowerCase().replace(/\\s+/g, ' ').trim();\n\nconst cache = JSON.parse(JSON.stringify(auftraege[0].json.cache));\nlet bewertet = 0, verworfen = 0, tokensIn = 0, tokensOut = 0, fehler = [];\nconst beruehrt = new Set();\nantworten.forEach((antwort, i) => {\n  const auftrag = auftraege[i].json;\n  if (antwort.json.error || !antwort.json.content) { fehler.push('Stapel ' + auftrag.stapel + ': ' + (antwort.json.error?.message || 'keine Antwort')); return; }\n  tokensIn += antwort.json.usage?.input_tokens || 0; tokensOut += antwort.json.usage?.output_tokens || 0;\n  let text = (antwort.json.content.find(c => c.type === 'text') || {}).text || '';\n  text = text.replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '').trim();\n  let liste;\n  try { liste = JSON.parse(text); } catch (e) { fehler.push('Stapel ' + auftrag.stapel + ': kein JSON'); return; }\n  for (const b of liste) {\n    const k = auftrag.kandidaten[b.id];\n    if (!k || typeof b.relevant !== 'boolean' || !b.kriterien) { verworfen++; continue; }\n    for (const [feld, werte] of Object.entries(ENUMS)) if (b[feld] !== undefined && !werte.includes(b[feld])) b[feld] = werte[werte.length - 1];\n    const beschreibung = norm(k.beschreibung);\n    const ungueltig = [];\n    b.zitate = b.zitate || {};\n    for (const [feld, zitat] of Object.entries(b.zitate)) {\n      if (zitat && !beschreibung.includes(norm(zitat))) { ungueltig.push(feld); b.zitate[feld] = null; }\n    }\n    const eintrag = { ...b, inhalts_hash: k.inhalts_hash, profil_hash: auftrag.profil_hash, bewertet_am: jetzt,\n      modell: cfg.modell, zitate_ungueltig: ungueltig };\n    if (!cache[k.quelle]) cache[k.quelle] = { sha: null, eintraege: {} };\n    cache[k.quelle].eintraege[k.key] = eintrag;\n    beruehrt.add(k.quelle);\n    bewertet++;\n  }\n});\nconst kosten = tokensIn / 1e6 * Number(cfg.preis_in_usd) + tokensOut / 1e6 * Number(cfg.preis_out_usd);\nconst laufId = $('Webhook').first().json.body?.lauf_id || 'manuell';\nconst zusammenfassung = { lauf_id: laufId, bewertet, verworfen, fehler, tokens_in: tokensIn, tokens_out: tokensOut,\n  kosten_usd: Math.round(kosten * 10000) / 10000, rest: auftraege[0].json.rest, offen_gesamt: auftraege[0].json.offen_gesamt, datum: jetzt };\nif (bewertet === 0 && fehler.length) throw new Error('Keine Bewertung gelungen: ' + fehler.join('; '));\nreturn Object.entries(cache).filter(([q]) => beruehrt.has(q)).map(([quelle, c]) => ({ json: {\n  quelle, sha: c.sha, content_b64: Buffer.from(JSON.stringify(c.eintraege, null, 1)).toString('base64'), ...zusammenfassung } }));",
        "mode": "runOnceForAllItems"
      },
