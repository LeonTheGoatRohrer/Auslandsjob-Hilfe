    {
      "parameters": {
        "jsCode": "// Offene Kandidaten bestimmen (kein Cache-Eintrag, Inhalt geändert oder Profil geändert) und Aufträge für Claude bauen.\nconst cfg = $('Konfiguration').first().json;\nconst kandidaten = $('Kandidaten lesen').first().json.kandidaten || [];\nconst profil = $('Profil lesen').first().json.data;\nconst vorlage = $('Prompt lesen').first().json.data;\n\nfunction hash(text) { let h = 5381; for (const c of text) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0; return h.toString(16); }\nconst profilHash = hash(profil);\n\n// Cache je Quelle: Datei fehlt (404) → leer\nconst cache = {};\nconst quellen = $('Cache-Dateien bestimmen').all().map(i => i.json.quelle);\n$input.all().forEach((item, i) => {\n  const quelle = quellen[i];\n  if (item.json.error || !item.json.content) { cache[quelle] = { sha: null, eintraege: {} }; return; }\n  const text = Buffer.from(item.json.content, 'base64').toString('utf8');\n  cache[quelle] = { sha: item.json.sha, eintraege: JSON.parse(text) };\n});\n\nconst offen = kandidaten.filter(k => {\n  const e = (cache[k.quelle] || { eintraege: {} }).eintraege[k.key];\n  return !e || e.inhalts_hash !== k.inhalts_hash || e.profil_hash !== profilHash;\n});\n\n// Kategorie-Schlüssel aus dem Profil (Zeilen mit zwei Leerzeichen Einrückung unter \"kategorien:\")\nconst block = (profil.split(/\\nkategorien:\\n/)[1] || '').split(/\\n(?=\\S)/)[0];\nconst kategorien = [...block.matchAll(/^  ([a-z_]+):/gm)].map(m => m[1]);\n\nconst groesse = Number(cfg.stapel_groesse), max = Number(cfg.max_stapel);\nconst jetzt = offen.slice(0, groesse * max);\nconst auftraege = [];\nfor (let i = 0; i < jetzt.length; i += groesse) {\n  const stapel = jetzt.slice(i, i + groesse);\n  const angebote = stapel.map(a => ({ id: a.key, titel: a.titel, organisation: a.organisation, ort: a.ort, region: a.region,\n    land: a.land, veroeffentlicht: a.veroeffentlicht, frist: a.frist, extra: a.extra, beschreibung: (a.beschreibung || '').slice(0, 2500) }));\n  const prompt = vorlage.replace('{profil}', profil).replace('{kategorien}', kategorien.join(' | '))\n    .replace('{angebote}', JSON.stringify(angebote, null, 1));\n  auftraege.push({ json: { stapel: auftraege.length + 1, prompt, kandidaten: Object.fromEntries(stapel.map(a => [a.key, a])),\n    profil_hash: profilHash, cache, rest: offen.length - jetzt.length, offen_gesamt: offen.length } });\n}\nif (auftraege.length === 0) return [{ json: { leer: true, rest: 0, offen_gesamt: 0, cache } }];\nreturn auftraege;",
        "mode": "runOnceForAllItems"
      },
