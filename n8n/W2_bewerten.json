    {
      "parameters": {
        "jsCode": "// Welche Quellen kommen in den Kandidaten vor? Je Quelle liegt eine Cache-Datei llm_cache/<quelle>.json.\nconst kandidaten = $('Kandidaten lesen').first().json.kandidaten || [];\nconst quellen = [...new Set(kandidaten.map(k => k.quelle))];\nreturn quellen.map(quelle => ({ json: { quelle } }));",
