      "parameters": {
        "jsCode": "// Kostenprotokoll ergänzen (lauf_kosten.json: Liste der Bewertungsläufe)\nconst alt = $input.first().json;\nconst liste = alt.error || !alt.content ? [] : JSON.parse(Buffer.from(alt.content, 'base64').toString('utf8'));\nconst z = $('Antworten prüfen').first().json;\nliste.push({ datum: z.datum, lauf_id: z.lauf_id, bewertet: z.bewertet, verworfen: z.verworfen, tokens_in: z.tokens_in,\n  tokens_out: z.tokens_out, kosten_usd: z.kosten_usd, fehler: z.fehler });\nreturn [{ json: { sha: alt.sha || null, content_b64: Buffer.from(JSON.stringify(liste.slice(-500), null, 1)).toString('base64'),\n  rest: z.rest, lauf_id: z.lauf_id } }];",
