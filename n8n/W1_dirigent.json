{
  "name": "Auslandsjob W1 Dirigent",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 6 * * *" }
          ]
        }
      },
      "name": "Täglich 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "name": "Manuell starten",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "owner", "value": "LeonTheGoatRohrer", "type": "string" },
            { "id": "a2", "name": "repo", "value": "Auslandsjob-Hilfe", "type": "string" },
            { "id": "a3", "name": "branch", "value": "main", "type": "string" }
          ]
        },
        "options": {}
      },
      "name": "Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/actions/workflows/sammeln.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ref: $json.branch, inputs: { quellen: \"\", demo: false } }) }}",
        "options": { "timeout": 30000 }
      },
      "name": "Sammellauf starten (GitHub Actions)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "credentials": { "httpHeaderAuth": { "name": "GitHub PAT (Authorization)" } }
    }
  ],
  "connections": {
    "Täglich 06:00": { "main": [[{ "node": "Konfiguration", "type": "main", "index": 0 }]] },
    "Manuell starten": { "main": [[{ "node": "Konfiguration", "type": "main", "index": 0 }]] },
    "Konfiguration": { "main": [[{ "node": "Sammellauf starten (GitHub Actions)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Vienna" }
}
